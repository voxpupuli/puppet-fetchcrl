<% |
  String[1] $anchorname,
  Optional[Integer] $agingtolerance = undef,
  Boolean $nowarnings,
  Boolean $noerrors,
  Boolean $nohttp_proxy,
  Boolean $nohttps_proxy,
  Boolean $noverify_nextupdate,
  Boolean $noverify_lastupdate,
  Optional[Integer] $httptimeout = undef,
  Array[Stdlib::Httpurl] $crl_url,
  Optional[String] $comment = undef,
| -%>
# <%= $anchorname -%>.conf file installed with puppet.

<% if $comment { -%>
# <%= $comment %>

<% } -%>
[<%= $anchorname -%>]
<% if $agingtolerance { -%>
agingtolerance = <%= $agingtolerance %>
<% } -%>
<% if $nowarnings { -%>
nowarnings
<% } -%>
<% if $noerrors { -%>
noerrors
<% } -%>
<% if $nohttp_proxy { -%>
nohttp_proxy
<% } -%>
<% if $nohttps_proxy { -%>
nohttps_proxy
<% } -%>
<% if $noverify_nextupdate { -%>
noverify_nextupdate
<% } -%>
<% if $noverify_lastupdate { -%>
noverify_lastupdate
<% } -%>
<% if $httptimeout { -%>
httptimeout = <%= $httptimeout %>
<% } -%>
<% if $crl_url.length >= 1 { -%>
crl_url.1 = <%= $crl_url.join(';') %>
<% } -%>

# end of <%= $anchorname -%>.conf  managed by puppet.
